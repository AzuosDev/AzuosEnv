# Ambiente
NODE_ENV=development
PORT=3000

# Log estruturado (nestjs-pino): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Banco
MONGODB_URI=mongodb://localhost:27017/azuos-env

# CORS (lista separada por virgula)
CORS_ORIGINS=http://localhost:5173
# Rate limit global por IP: janela em ms e teto de requisicoes na janela.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# CORS dos formularios publicos (site da Azuos Dev)
PUBLIC_FORM_ORIGINS=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# URL do app (links de convite)
APP_URL=http://localhost:5173
# Origem publica desta API. E dela que sai a URL do webhook do WhatsApp: a que o
# app da Meta chama (Cloud API) e a que fica gravada na instancia da Evolution,
# que inclui o segredo gerado ao salvar a conexao. Em producao tem de ser a URL
# publica do backend, alcancavel pelo servidor da Evolution.
API_PUBLIC_URL=http://localhost:3000

# Uploads (LocalDiskStorage). Qualquer tipo de arquivo e aceito; UPLOAD_MAX_MB e o
# teto por arquivo (1 a 512; o upload passa pela memoria do processo).
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=50

# Bucket dos anexos (R2, S3 ou MinIO). Com S3_BUCKET preenchido os arquivos vao
# para o bucket; vazio mantem o disco local do UPLOAD_DIR. Host serverless perde
# o disco no cold start, entao em producao o bucket e obrigatorio. No R2 o
# endpoint e https://<account_id>.r2.cloudflarestorage.com e a regiao fica auto.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tempo real do chat e das notificacoes. Com ABLY_API_KEY o servidor publica no
# Ably por REST e o navegador conecta la (unico caminho que funciona em host
# serverless, onde o WebSocket proprio nao sobe). Sem a chave vale o gateway
# Socket.IO do proprio processo (Docker/Railway). Chave: <appId>.<keyId>:<secret>
ABLY_API_KEY=

# Web Push das notificacoes (funciona em serverless: enviar e um POST para o
# servico do navegador). Gere o par com: npx web-push generate-vapid-keys
# Sem as chaves o push fica desligado e a tela de ajustes esconde a opcao.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@azuos.dev

# E-mail: com BREVO_API_KEY o envio vai pela API HTTP da Brevo (caminho de
# producao em serverless); sem ela cai no SMTP abaixo. MAIL_FROM precisa ser um
# remetente validado na Brevo; vazio, vale o SMTP_FROM.
BREVO_API_KEY=
MAIL_FROM=

# Caixa de saida em arquivo, so para o e2e do front (NODE_ENV=test)
# MAIL_CAPTURE=false
# MAIL_CAPTURE_FILE=./storage/e2e-mailbox.jsonl

# SMTP (sem SMTP_HOST o e-mail so vai para o log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Azuos Env <no-reply@azuos.dev>

# Seed (npm run seed)
SEED_NAME=Azuos Admin
SEED_EMAIL=admin@azuos.dev
SEED_PASSWORD=Azuos2026

# IA. Sem XAI_API_KEY o provider e o stub (nada sai do processo). Com a chave,
# GROK_MODEL passa a ser obrigatorio. A base aceita qualquer API compativel com
# a da OpenAI: xAI (https://api.x.ai/v1, chave xai-, modelo grok-*) ou Groq
# (https://api.groq.com/openai/v1, chave gsk_, ex.: openai/gpt-oss-120b).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
AI_MONTHLY_TOKEN_BUDGET=1000000

# Segredos em repouso (tokens OAuth, secrets de webhook). Vazio usa JWT_ACCESS_SECRET.
ENCRYPTION_KEY=

# Google Agenda (OAuth2). Sem GOOGLE_CLIENT_ID o CalendarProvider continua o stub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

# Login com Google (reaproveita GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET acima).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# URL do front: destino do callback (/auth/callback) e dos erros (/login?erro=google).
FRONTEND_URL=http://localhost:5173
# Google falso para desenvolvimento e testes do front. Proibido em producao.
GOOGLE_MOCK=false

# WhatsApp. O provedor e um campo da conexao, nao do ambiente: a Evolution API
# v2 (Baileys, conexao por QR Code) e o padrao e a Cloud API oficial continua
# funcionando para quem ja estava nela. URL, API key e nome da instancia da
# Evolution, e numero, tokens e App Secret da Cloud API, ficam no banco,
# criptografados; aqui so a versao da Graph API usada nas chamadas.
#
# A Evolution sobe em Docker, com Postgres e Redis, e nao precisa de variavel
# aqui: o passo a passo esta em docs/DEPLOY.md.
META_GRAPH_VERSION=v21.0
# WhatsApp falso (os dois provedores) para desenvolvimento e para o e2e do
# front; proibido em producao.
WHATSAPP_MOCK=false
