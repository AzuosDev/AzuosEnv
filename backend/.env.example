# Ambiente
NODE_ENV=development
PORT=3000

# Log estruturado (nestjs-pino): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Banco
MONGODB_URI=mongodb://localhost:27017/azuos-env

# CORS (lista separada por virgula)
CORS_ORIGINS=http://localhost:5173
# Rate limit global por IP: janela em ms e teto de requisicoes na janela.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# CORS dos formularios publicos (site da Azuos Dev)
PUBLIC_FORM_ORIGINS=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# URL do app (links de convite)
APP_URL=http://localhost:5173

# Uploads (LocalDiskStorage)
UPLOAD_DIR=./storage/uploads

# E-mail: com BREVO_API_KEY o envio vai pela API HTTP da Brevo (caminho de
# producao em serverless); sem ela cai no SMTP abaixo. MAIL_FROM precisa ser um
# remetente validado na Brevo; vazio, vale o SMTP_FROM.
BREVO_API_KEY=
MAIL_FROM=

# SMTP (sem SMTP_HOST o e-mail so vai para o log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Azuos Env <no-reply@azuos.dev>

# Seed (npm run seed)
SEED_NAME=Azuos Admin
SEED_EMAIL=admin@azuos.dev
SEED_PASSWORD=Azuos2026

# IA. Sem XAI_API_KEY o provider e o stub (nada sai do processo). Com a chave,
# GROK_MODEL passa a ser obrigatorio. A base aceita qualquer API compativel com
# a da OpenAI: xAI (https://api.x.ai/v1, chave xai-, modelo grok-*) ou Groq
# (https://api.groq.com/openai/v1, chave gsk_, ex.: openai/gpt-oss-120b).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
AI_MONTHLY_TOKEN_BUDGET=1000000

# Segredos em repouso (tokens OAuth, secrets de webhook). Vazio usa JWT_ACCESS_SECRET.
ENCRYPTION_KEY=

# Google Agenda (OAuth2). Sem GOOGLE_CLIENT_ID o CalendarProvider continua o stub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

# Login com Google (reaproveita GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET acima).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# URL do front: destino do callback (/auth/callback) e dos erros (/login?erro=google).
FRONTEND_URL=http://localhost:5173
# Google falso para desenvolvimento e testes do front. Proibido em producao.
GOOGLE_MOCK=false

# WhatsApp Cloud API (Etapa 19). Numero, tokens e App Secret ficam no banco,
# criptografados; aqui so a versao da Graph API usada nas chamadas.
META_GRAPH_VERSION=v21.0
