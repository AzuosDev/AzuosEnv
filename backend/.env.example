# Ambiente
NODE_ENV=development
PORT=3000

# Banco
MONGODB_URI=mongodb://localhost:27017/azuos-env

# CORS (lista separada por virgula)
CORS_ORIGINS=http://localhost:5173

# CORS dos formularios publicos (site da Azuos Dev)
PUBLIC_FORM_ORIGINS=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# URL do app (links de convite)
APP_URL=http://localhost:5173

# Uploads (LocalDiskStorage)
UPLOAD_DIR=./storage/uploads

# SMTP (sem SMTP_HOST o e-mail so vai para o log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Azuos Env <no-reply@azuos.dev>

# Seed (npm run seed)
SEED_NAME=Azuos Admin
SEED_EMAIL=admin@azuos.dev
SEED_PASSWORD=Azuos2026

# IA (xAI / Grok). Sem XAI_API_KEY o provider e o stub (nada sai do processo).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
AI_MONTHLY_TOKEN_BUDGET=1000000

# Segredos em repouso (tokens OAuth, secrets de webhook). Vazio usa JWT_ACCESS_SECRET.
ENCRYPTION_KEY=

# Google Agenda (OAuth2). Sem GOOGLE_CLIENT_ID o CalendarProvider continua o stub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
